# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── API (apps/api) ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4100
CORS_ORIGIN=http://localhost:3100

# PostgreSQL (required for Phase 6 persistence; optional in Phase 1)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_agent?schema=public

# Redis / BullMQ (optional — falls back to in-process queue when unset)
REDIS_URL=
QUEUE_MODE=auto
# QUEUE_MODE: auto | redis | memory
# auto = use Redis when REDIS_URL is set, otherwise memory

# Live calling gate — must stay false until credentials, consent, country, and spend limits are verified
LIVE_CALLING_ENABLED=false
MAX_CONCURRENT_CALLS=2
DAILY_CALL_SPEND_LIMIT_USD=0

# AI (server-side only — never expose to the browser)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Provider selection (simulated until Phase 5 verification)
TELEPHONY_PROVIDER=simulated
STT_PROVIDER=simulated
TTS_PROVIDER=simulated
CONVERSATION_PROVIDER=groq

# Telephony credentials (leave empty until verified)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_SUBDOMAIN=

# Data retention (days); 0 = keep indefinitely (not recommended for production)
TRANSCRIPT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90

# ── Web (apps/web) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4100
